+	 * that the program can tell a copy from the original packet. The
+	 * verifier only accepts a clone action on a path where the program
+	 * proved that this metadata is not there, which also rules out
+	 * nested clones.
+	 */
+	XDP_CLONE_PASS,
+	XDP_CLONE_TX,
 };
 
+/* Bits of an XDP return value that hold the action; the remaining upper bits
+ * hold the number of copies for XDP_CLONE_PASS / XDP_CLONE_TX.
+ */
+#define XDP_CLONE_NUM_SHIFT	5
+#define XDP_CLONE_ACT_MASK	((1U << XDP_CLONE_NUM_SHIFT) - 1)
+/* Bytes of metadata the driver stores in front of xdp_md->data before it
+ * re-runs the program on a copy of the packet.
+ */
+#define XDP_CLONE_META_SIZE	4
+
 /* user accessible metadata for XDP packet hook
  * new fields must be added to the end of this structure
  */
